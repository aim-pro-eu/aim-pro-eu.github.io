---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.vue';
import Footer from '../../components/Footer.vue';
import FaqAccordion from '../../components/ui/FaqAccordion.vue';
import { getEntry } from 'astro:content';
import { createMarkdownProcessor } from '@astrojs/markdown-remark';

const faqEntry = await getEntry('faq', 'faq');
const questions = faqEntry?.data.questions ?? [];

const markdownProcessor = await createMarkdownProcessor();
const renderedFaqs = await Promise.all(
  questions.map(async (question) => ({
    title: question.title,
    html: (await markdownProcessor.render(question.answer)).code,
  }))
);
---

<Layout title="FAQ | AIM-PRO">
  <Navbar client:load />

  <main class="pt-32 pb-20 bg-slate-50 min-h-screen">
    <div class="max-w-4xl mx-auto px-6 lg:px-8">
      <header class="text-center mb-12">
        <h1 class="text-4xl font-bold text-slate-900 mb-4">
          Frequently Asked Questions
        </h1>
        <p class="text-lg text-slate-600">
          Find answers to the most common questions about the AIM-PRO project.
        </p>
      </header>

      <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 md:p-8">
        <div class="flex justify-end mb-6">
          <button
            id="toggle-all-faq"
            class="px-6 py-2 bg-blue-700 hover:bg-blue-600 text-white text-sm font-medium rounded-md transition-colors flex items-center justify-center gap-2 shadow-sm"
          >
            <svg
              id="faq-toggle-icon"
              class="w-4 h-4 transition-transform duration-300"
              fill="none" viewBox="0 0 24 24" stroke="currentColor"
            >
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
            <span id="faq-toggle-text">Expand All</span>
          </button>
        </div>

        <div class="space-y-2" id="faq-container">
          {
            renderedFaqs.map((item) => (
              <FaqAccordion client:load question={item.title} data-faq-item>
                <div class="prose prose-slate max-w-none" set:html={item.html} />
              </FaqAccordion>
            ))
          }
        </div>
      </div>
    </div>
  </main>

  <Footer client:visible />
</Layout>

<script>
  const btn = document.getElementById('toggle-all-faq');
  const textSpan = document.getElementById('faq-toggle-text');
  const icon = document.getElementById('faq-toggle-icon');

  let isExpanded = false;

  if (btn) {
    btn.addEventListener('click', () => {
        isExpanded = !isExpanded;

        if (textSpan) textSpan.textContent = isExpanded ? 'Collapse All' : 'Expand All';
        if (icon) {
          icon.style.transform = isExpanded ? 'rotate(180deg)' : 'rotate(0deg)';
        }

        window.dispatchEvent(new CustomEvent('toggle-all-faqs'));
    });
  }
</script>
