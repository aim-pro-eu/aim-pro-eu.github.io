---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.vue';
import Footer from '../components/Footer.vue';
import UnsubscribeForm from '../components/UnsubscribeForm.vue';
---

<Layout title="Unsubscribe | AIM-PRO">
  <Navbar client:load />

  <main class="pt-32 pb-20 bg-slate-50 min-h-screen">
    <div class="max-w-xl mx-auto px-6 lg:px-8">
      <header class="text-center mb-12">
        <h1 class="text-4xl font-bold text-slate-900 mb-4">
          Unsubscribe
        </h1>
        <p class="text-lg text-slate-600 leading-relaxed">
          Enter your email address to stop receiving the AIM-PRO newsletter.
        </p>
      </header>

      <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 md:p-8">
        <UnsubscribeForm client:load />
      </div>
    </div>
  </main>

  <Footer client:visible />
</Layout>
